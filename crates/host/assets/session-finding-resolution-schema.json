{
  "type": "array",
  "maxItems": 64,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "taskId",
      "findingId",
      "state",
      "reason",
      "evidenceSeqs"
    ],
    "properties": {
      "taskId": {
        "type": "string"
      },
      "findingId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "state": {
        "enum": [
          "resolved",
          "wontfix",
          "open",
          "blocker"
        ]
      },
      "reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "evidenceSeqs": {
        "type": "array",
        "minItems": 1,
        "maxItems": 16,
        "uniqueItems": true,
        "items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  }
}