{
  "continuity": {
    "enum": [
      "auto",
      "fresh",
      "native"
    ]
  },
  "continuityJustification": {
    "type": "string",
    "minLength": 1,
    "maxLength": 512
  },
  "acceptance": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "items"
    ],
    "properties": {
      "items": {
        "type": "array",
        "maxItems": 32,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "text"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          }
        }
      },
      "refs": {
        "type": "array",
        "maxItems": 16,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string",
              "maxLength": 512
            },
            "anchor": {
              "type": "string",
              "maxLength": 128
            }
          }
        }
      }
    }
  },
  "findings": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "items"
    ],
    "properties": {
      "mode": {
        "enum": [
          "merge",
          "replace"
        ]
      },
      "items": {
        "type": "array",
        "maxItems": 128,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "state",
            "text"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "state": {
              "enum": [
                "open",
                "blocker",
                "resolved",
                "wontfix"
              ]
            },
            "severity": {
              "enum": [
                "blocker",
                "major",
                "minor",
                "info"
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "resolution": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "evidenceSeqs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "taskId",
                "attempt"
              ],
              "properties": {
                "taskId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "attempt": {
                  "type": "integer",
                  "minimum": 1
                },
                "findingId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                }
              }
            }
          }
        }
      }
    }
  },
  "sourceTasks": {
    "type": "array",
    "maxItems": 8,
    "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "attempt"
      ],
      "properties": {
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}