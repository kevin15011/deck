{
  "name": "deck",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deck": "bun run --cwd apps/cli deck",
    "build": "bun run bench:memory && bun run verify:supermemory-compiled && bun run scripts/build-binaries.ts",
    "build:dry-run": "bun run scripts/build-binaries.ts --dry-run",
    "canary:install": "bun run scripts/install-canary.ts",
    "deck:run": "DECK_DEBUG=1 bun run build:dry-run && DECK_DEBUG=1 ./dist/cli/deck",
    "test": "bun test --timeout 30000",
    "bench:memory": "bun run benchmarks/deckmemorybench.ts",
    "verify:supermemory-compiled": "bun run scripts/verify-supermemory-compiled-runtime.ts --dry-run",
    "release:verify": "bun run bench:memory && bun run verify:supermemory-compiled && bun run build:dry-run"
  },
  "bin": {
    "deck": "./dist/cli/deck"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "latest",
    "typescript": "latest"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
