{
  "name": "deck",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "deck": "bun run --cwd apps/cli deck",
    "build": "bun run bench:memory && bun run verify:supermemory-compiled && bun run scripts/build-binaries.ts",
    "build:dry-run": "bun run scripts/build-binaries.ts --dry-run",
    "canary:install": "bun run scripts/install-canary.ts",
    "sandbox:linux": "bash scripts/linux-install-sandbox.sh",
    "sandbox": "bash scripts/linux-install-sandbox.sh with-deck",
    "sandbox:clean": "bash scripts/linux-install-sandbox.sh without-deck",
    "sandbox:update": "bash scripts/linux-install-sandbox.sh update",
    "deck:run": "DECK_DEBUG=1 bun run build:dry-run && DECK_DEBUG=1 ./dist/cli/deck",
    "test": "bun run test:fast",
    "bench:memory": "bun run benchmarks/deckmemorybench.ts",
    "verify:supermemory-compiled": "bun run scripts/verify-supermemory-compiled-runtime.ts --dry-run",
    "release:verify": "bun run bench:memory && bun run verify:supermemory-compiled && bun run build:dry-run",
    "test:fast": "bun scripts/test.ts --tier fast",
    "test:changed": "bun scripts/test.ts --changed",
    "test:int": "bun scripts/test.ts --tier int",
    "test:e2e": "bun scripts/test.ts --tier e2e",
    "test:full": "bun scripts/test.ts --tier all",
    "test:quarantine": "bun scripts/test.ts --quarantine"
  },
  "bin": {
    "deck": "./dist/cli/deck"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "latest",
    "opencode-supermemory": "2.0.15",
    "typescript": "latest"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
