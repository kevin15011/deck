{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "bun"
    ]
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts"
  ],
  "exclude": [
    "packages/core/src/skills/external/*/scripts/**",
    "packages/core/src/skills/external/*/assets/**",
    "packages/core/src/skills/external/visual-explainer/extension.ts"
  ]
}
